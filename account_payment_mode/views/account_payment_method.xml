<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The base payment method UI is now provided by
         account_payment_method_base. These XML IDs are kept as compatibility
         anchors for downstream addons that still inherit from
         account_payment_mode.* -->
    <record id="account_payment_method_form" model="ir.ui.view">
        <field name="name">account_payment_mode.account_payment_method.form</field>
        <field name="model">account.payment.method</field>
        <field
            name="inherit_id"
            ref="account_payment_method_base.account_payment_method_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <widget
                    name="web_ribbon"
                    title="Archived"
                    bg_color="bg-danger"
                    invisible="active"
                />
            </xpath>
            <xpath
                expr="//group[@name='main']/field[@name='code']"
                position="attributes"
            >
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath
                expr="//group[@name='main']/field[@name='payment_type']"
                position="after"
            >
                <field name="bank_account_required" />
            </xpath>
        </field>
    </record>

    <!--Keep these for back compatibility-->
    <record id="account_payment_method_tree" model="ir.ui.view">
        <field name="name">account_payment_mode.account_payment_method.list</field>
        <field name="model">account.payment.method</field>
        <field
            name="inherit_id"
            ref="account_payment_method_base.account_payment_method_list"
        />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="account_payment_method_search" model="ir.ui.view">
        <field name="name">account_payment_mode.account_payment_method.search</field>
        <field name="model">account.payment.method</field>
        <field
            name="inherit_id"
            ref="account_payment_method_base.account_payment_method_search"
        />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside" />
        </field>
    </record>
</odoo>
