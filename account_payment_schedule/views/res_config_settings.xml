<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="print_vendor_checks_setting_container" position="inside">
                <setting
                    id="payment_schedule_minimum_balance_setting"
                    company_dependent="1"
                    help="The payment schedule warns about the dates whose projected balance is below this amount."
                >
                    <field name="payment_schedule_minimum_balance" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
