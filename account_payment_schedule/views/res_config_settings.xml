<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="account_payment_order.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='transfer_journal']" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <label for="payment_schedule_minimum_balance" />
                        <div class="text-muted">
                            The payment schedule warns about the dates whose projected
                            balance is below this amount.
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <field name="payment_schedule_minimum_balance" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
