<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_payment_line_view_list" model="ir.ui.view">
        <field name="name">account.payment.line.list.inherit.early.payment</field>
        <field name="model">account.payment.line</field>
        <field
            name="inherit_id"
            ref="account_payment_order.account_payment_line_tree"
        />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="preferred_supplier" optional="show" />
            </field>
        </field>
    </record>
</odoo>
