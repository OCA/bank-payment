<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_payment_line_form" model="ir.ui.view">
        <field name="name">account.payment.line.form.early.discount</field>
        <field name="model">account.payment.line</field>
        <field
            name="inherit_id"
            ref="account_payment_order.account_payment_line_form"
        />
        <field name="arch" type="xml">
            <field name="ml_maturity_date" position="after">
                <field name="early_discount_date" invisible="not early_discount_date" />
                <field
                    name="early_discount_amount"
                    invisible="not early_discount_amount"
                    force_save="1"
                />
                <field name="early_discount_residual" invisible="1" force_save="1" />
            </field>
        </field>
    </record>
    <record id="account_payment_line_tree" model="ir.ui.view">
        <field name="name">account.payment.line.list.early.discount</field>
        <field name="model">account.payment.line</field>
        <field
            name="inherit_id"
            ref="account_payment_order.account_payment_line_tree"
        />
        <field name="arch" type="xml">
            <field name="ml_maturity_date" position="after">
                <field name="early_discount_date" optional="show" />
            </field>
            <field name="amount_currency" position="after">
                <field
                    name="early_discount_amount"
                    optional="show"
                    sum="Total early discount"
                    force_save="1"
                />
                <field
                    name="early_discount_residual"
                    column_invisible="1"
                    force_save="1"
                />
            </field>
        </field>
    </record>
</odoo>
