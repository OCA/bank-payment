<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_plaid_partner_bank_form" model="ir.ui.view">
        <field name="name">account.plaid.res.partner.bank.form</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='acc_number']" position="after">
                <field name="plaid_account_id" />
                <field name="plaid_access_token" />
                <field name="plaid_routing_number" />
                <field name="plaid_subtype" />
            </xpath>
        </field>
    </record>
</odoo>
