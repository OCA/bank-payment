<odoo>
    <record id="account_payment_api_second_factor_form" model="ir.ui.view">
        <field name="model">account.payment.api.second.factor</field>
        <field name="arch" type="xml">
            <form>
                <p>Enter the 6-digit code from your authenticator app.</p>
                <group>
                    <field name="description" />
                    <field
                        name="code"
                        required="1"
                        autocomplete="off"
                        placeholder="e.g. 123456"
                        default_focus="1"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
