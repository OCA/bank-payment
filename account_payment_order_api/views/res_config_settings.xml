<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="after">
                <block title="Payment Orders" id="account_payment_order_api">
                    <setting
                        company_dependent="1"
                        help="The user who enters the authenticator code must differ from the user who confirmed the payment order. Applies to the payment modes that require the code."
                    >
                        <field name="api_second_person_required" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
