<odoo>
    <record id="account_payment_schedule_replan_form" model="ir.ui.view">
        <field name="model">account.payment.schedule.replan</field>
        <field name="arch" type="xml">
            <form string="Replan by Priority">
                <div class="alert alert-info" role="alert">
                    On each date short of cash in the next 30 days, the lowest
                    priority items, latest due date first, move to the first date
                    from which the projected balance stays at or above the minimum.
                    Critical items and items of confirmed payment orders keep their
                    date.
                </div>
                <div
                    class="alert alert-success"
                    role="status"
                    invisible="move_ids or kept_ids or short_summary"
                >
                    No date in the next 30 days is short of cash.
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not short_summary"
                >
                    <p>These dates stay below the minimum balance:</p>
                    <field name="short_summary" nolabel="1" readonly="1" />
                </div>
                <separator string="Items to Move" invisible="not move_ids" />
                <field
                    name="move_ids"
                    nolabel="1"
                    readonly="1"
                    invisible="not move_ids"
                >
                    <list create="0" delete="0">
                        <field name="company_currency_id" column_invisible="1" />
                        <field name="partner_id" />
                        <field name="move_id" string="Document" />
                        <field
                            name="payment_priority"
                            widget="badge"
                            decoration-danger="payment_priority == '1'"
                            decoration-warning="payment_priority == '2'"
                            decoration-muted="payment_priority == '4'"
                        />
                        <field name="date_maturity" />
                        <field name="payment_schedule_date" string="Current Date" />
                        <field name="new_date" />
                        <field name="amount_residual" sum="Total" />
                    </list>
                </field>
                <separator
                    string="Items Kept: no later date with enough balance"
                    invisible="not kept_ids"
                />
                <field
                    name="kept_ids"
                    nolabel="1"
                    readonly="1"
                    invisible="not kept_ids"
                >
                    <list create="0" delete="0">
                        <field name="company_currency_id" column_invisible="1" />
                        <field name="partner_id" />
                        <field name="move_id" string="Document" />
                        <field name="payment_priority" widget="badge" />
                        <field name="date_maturity" />
                        <field name="payment_schedule_date" />
                        <field name="amount_residual" sum="Total" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                        invisible="not move_ids"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
