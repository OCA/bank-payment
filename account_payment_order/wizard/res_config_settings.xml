<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="after">
                <block id="payment_orders" title="Payment Orders">
                    <setting id="allow_out_payment_order"
                             title="Use allow out payment on partner bank"
                             help="If checked, we will check that the account on payment order can be used for out payments">
                        <field name="use_allow_out_payment"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
